# Ignore everything at the project root
/*

# Keep documentation
!/.gitignore
!/README.md

# Keep only the selected notebooks
!/notebooks/
/notebooks/*
!notebooks/01_dataset_exploration.ipynb
!notebooks/02_dataset_selection.ipynb

# Results: allow only selected folders
!/results/
/results/*

# Metrics
!/results/metrics/
/results/metrics/*
!results/metrics/held_out_evaluation_comparison.csv

# Plots
!/results/plots/
/results/plots/*
!results/plots/overall_metric_comparison.png

# Predictions
!/results/predictions/
/results/predictions/*
!results/predictions/Figure_1_Nighttime_Input.png
!results/predictions/Figure_2_Baseline_vs_Adapted.png

# Final dashboard
!/results/final_comparison/
/results/final_comparison/*
!results/final_comparison/NightSight_Research_Dashboard.pdf
!results/final_comparison/NightSight_Research_Dashboard.png
